    "babel-preset-solid": "^1.9.0",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/core": "^7.26.0",
    "solid-js": "^1.9.0",
    "retro-crt": "*"
  },
  "author": "pixelyokai",
  "homepage": "https://github.com/pixelyokai/retro-crt/tree/main/packages/solid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelyokai/retro-crt.git",
    "directory": "packages/solid"
  },
  "bugs": {
    "url": "https://github.com/pixelyokai/retro-crt/issues"
  },
